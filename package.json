{
  "name": "arkya-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://arkya.store",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.js && vite build && node scripts/prerender.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "extract-images": "node scripts/extract-images.js",
    "extract:images": "node scripts/extract-images.js",
    "fix-image-paths": "node scripts/fix-image-paths.js",
    "fix:paths": "node scripts/fix-image-paths.js",
    "server": "node server.cjs",
    "install-python-deps": "pip install instaloader selenium webdriver-manager",
    "install-selenium": "pip install selenium webdriver-manager"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@emailjs/browser": "^4.4.1",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "framer-motion": "^10.18.0",
    "heic2any": "^0.0.4",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.3.0",
    "sharp": "^0.35.2",
    "vite": "^7.0.4"
  },
  "optionalDependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2"
  }
}
